<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Line 1: App Info + Host/IP + Relative Time / Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="App Icon"
                android:src="@drawable/ic_navigation_apps" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/primaryOrTextPrimary"
                    android:textStyle="bold"
                    tools:text="connectivitycheck.gstatic.com:443" />

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/primaryOrTextSecondary"
                    tools:text="Google Play 服务" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTimeAndStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_pill"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/primaryOrTextSecondary"
                tools:text="刚刚" />

        </LinearLayout>

        <!-- Line 2: Inbound / Protocol Tag + Cumulative Traffic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvInboundAndProto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_pill"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/primaryOrTextSecondary"
                tools:text="tun-in | TCP" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Cumulative Upload & Download -->
            <TextView
                android:id="@+id/tvTrafficUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ 124 KB"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="#3B82F6"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTrafficDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="↓ 1.2 MB"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="#10B981"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Line 3: Routing Rule & Outbound + Realtime Speed + Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRuleAndChain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/primaryOrTextSecondary"
                tools:text="GeoIP(cn) ⊙ [直连]" />

            <TextView
                android:id="@+id/tvRealtimeSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/primaryOrTextSecondary"
                tools:text="↑ 1.2 KB/s  ↓ 45 KB/s" />

            <ImageView
                android:id="@+id/btnCloseSingle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Connection"
                android:padding="5dp"
                android:src="@drawable/ic_navigation_close"
                app:tint="#EF4444" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
